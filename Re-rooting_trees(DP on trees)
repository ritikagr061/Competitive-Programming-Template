vector<int> a;
 
void dfsCalcSubtreeDP(int root,int parent,vector<int> adj[],vector<bool> &vis,vector<int> &dp,vector<int> &store){
	vis[root]=true;
 
	for(auto it:adj[root]){
		if(!vis[it]){
			dfsCalcSubtreeDP(it,root,adj,vis,dp,store);
		}
	}
	dp[root]=0;
	store[root]=a[root];
	for(auto it:adj[root]){
			if(it!=parent){
				store[root]+=store[it];
				dp[root]+=dp[it]+store[it];
			}
	}
	return;
}
 
void reRoot(int oldRoot,int newRoot,vector<int> &dp, vector<int> &store){
	store[oldRoot]-=store[newRoot];
	dp[oldRoot]-=dp[newRoot]+store[newRoot];
 
	store[newRoot]+=store[oldRoot];
	dp[newRoot]+=dp[oldRoot]+store[oldRoot];
}
 
void dfsRerooting(int root,int parent,vector<int> adj[],vector<bool> &vis,vector<int> &dp, vector<int> &store,vector<int> &finalAns){
	vis[root]=true;
	finalAns[root]=dp[root];
 
	for(auto it:adj[root]){
		if(!vis[it]){
			reRoot(root,it,dp,store);  //rerooting from root to children
			dfsRerooting(it,root,adj,vis,dp,store,finalAns);
			reRoot(it,root,dp,store); //rerooting from child to root again
		}
	}
 
}
 
signed main(){
 
		int n;
		cin>>n;
		vector<int> adj[n+1];
 
		a.assign(n+1,0);
		for(int i=1;i<=n;i++)
			cin>>a[i];
 
		for(int i=0;i<n-1;i++){
			int x,y;
			cin>>x>>y;
			adj[x].push_back(y);
			adj[y].push_back(x);
		}
 
		vector<int> dp(n+1,0);
		vector<int> lengthStore(n+1);
		vector<bool> vis(n+1,false);
 
		dfsCalcSubtreeDP(1,-1,adj,vis,dp,lengthStore);
 
		// debug(dp);
		// debug(lengthStore);
 
		vis.assign(n+1,false);
		vector<int> finalAns(n+1);
		dfsRerooting(1,-1,adj,vis,dp,lengthStore,finalAns);
 
		int ansss=0;
		for(int i=1;i<=n;i++)
			ansss=max(ansss,finalAns[i]);
 
		cout<<ansss;
 
	return 0;
}
